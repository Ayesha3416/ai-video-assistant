# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore).

# ---- LLM (required) ----
# Get a key at https://console.groq.com
GROQ_API_KEY=

# ---- Transcription ----
# Local Whisper model size: tiny / base / small / medium / large. Bigger =
# more accurate, slower, more RAM. "small" is a reasonable default.
WHISPER_MODEL=small

# Only required if you use the "hinglish" language option.
# Get a key at https://www.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v2.5

# ---- Security ----
# Used for signing session cookies from Phase 2 onward. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_DAYS=14
BCRYPT_ROUNDS=12
# Comma-separated. Whoever logs in with one of these emails is bootstrapped
# as an admin (Phase 2/5). Leave blank until the admin dashboard exists.
ADMIN_EMAILS=

# ---- Model / pipeline tuning (safe to leave at defaults) ----
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_MINUTES=10
RETRIEVER_K=6

# ---- Retention (used from Phase 6) ----
FRAME_RETENTION_DAYS=30
DOWNLOAD_RETENTION_HOURS=6

# ---- App / logging ----
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_TO_FILE=true

# ---- Not used by the current codebase ----
# Kept here only because an earlier .env had it. Nothing imports "mistralai"
# anymore -- the app uses Groq exclusively (see CONTEXT.md, I-10).
# MISTRAL_API_KEY=
